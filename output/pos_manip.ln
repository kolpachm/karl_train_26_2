LINENO   84,2724,              GET_VAR(entry, '*SYSTEM*', str_var_name, tpp_frame_data, status)
LINENO   85,2798,              IF status <> 0 THEN
LINENO   86,2827,                  WRITE('Error getting frame data: ', status)
LINENO   87,2884,                  POST_ERR(status, '', 0, 2)
LINENO   88,2924,                  RETURN
LINENO   89,2944,              ENDIF
LINENO   90,2959,          ELSE
LINENO   91,2969,              tpp_frame_data = $MOR_GRP[1].$NILPOS
LINENO   92,3015,          ENDIF
LINENO   94,3076,          $GROUP[1].$UTOOL = tpp_tool_data
LINENO   95,3114,          $GROUP[1].$UFRAME = tpp_frame_data
LINENO   97,3176,          act_pos = CURPOS(0,0)
