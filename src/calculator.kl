%COMMENT = 'v0.7'
--%ALPHABETIZE
%NOLOCKGROUP
%NOBUSYLAMP
%NOPAUSE = ERROR + COMMAND + TPENABLE
%NOPAUSESHFT
%NOABORT = ERROR
--%SYSTEM
--%PRIORITY = 49
%INCLUDE KLEVKEYS
--%INCLUDE KLEVKMSK
%INCLUDE KLEVCCDF
--%INCLUDE KLIOUOP
--%INCLUDE KLIOTYPS
CONST
    OP_ADD          = 1
    OP_SUB          = 2
    OP_MUL          = 3
    OP_DIV          = 4
    OP_SQUARE       = 5
    OP_EXIT         = 99
--TYPE
VAR
operation       : INTEGER
num1            : REAL
num2            : REAL
result          : REAL
cont            :STRING[1]
status          : INTEGER
----------------------------------------------------
-- ROUTINE DECL
----------------------------------------------------
%INCLUDE my_lib_h
ROUTINE calc(num1_:REAL; num2_:REAL; ope_:INTEGER;status_:INTEGER):REAL FROM calculator

----------------------------------------------------
-- BEGIN calculator
----------------------------------------------------
BEGIN
    --init 
    operation = 0
    -- conditions
    CONDITION[1]:
        WHEN TPIN[ky_f1]+ DO
            operation = OP_ADD
        WHEN TPIN[ky_f2]+ DO
            operation = OP_SUB
        WHEN TPIN[ky_f3]+ DO
            operation = OP_MUL
        WHEN TPIN[ky_f4]+ DO
            operation = OP_DIV
        WHEN TPIN[ky_f5]+ DO
            operation = OP_SQUARE
    ENDCONDITION 
    -- force & clear user screen
    clear_screen(TPERROR)
    FORCE_SPMENU(TP_PANEL, SPI_TPUSER, 1)
    -- welcome
    WRITE TPERROR('Welcome to the amazing calculator!')

    WHILE (operation <> OP_EXIT) DO
        operation = 0
        clear_screen(TPDISPLAY)
        clear_screen(TPFUNC)
         -- ask user for num1 
        WRITE TPDISPLAY('Enter first number: ')
        READ TPDISPLAY(num1)
        -- ask user for num2
        WRITE TPDISPLAY('Enter second number: ')
        READ TPDISPLAY(num2)
        WRITE TPFUNC('  ADD    SUB    MUL     DIV      SQUARE  ')
        ENABLE CONDITION[1]
        WAIT FOR (operation <> 0)
        -- perform calculation
        result = calc(num1,num2,operation,status)
        IF (status <> 0) THEN
            WRITE TPDISPLAY('Calculation error, status: ', status, CR)
            operation = OP_EXIT
        ENDIF
         -- display result
        IF (operation <> OP_EXIT) THEN
            WRITE TPDISPLAY('Result: ', result::10::2,CR)
            WRITE TPDISPLAY(CR)
            WRITE TPDISPLAY('Continue? Y/N',CR)
            READ TPDISPLAY(cont)
            IF ((cont = 'N') OR (cont = 'n')) THEN
                operation = OP_EXIT 
            ENDIF
        ENDIF
         continue_::
    ENDWHILE
    clear_screen(TPDISPLAY)
    clear_screen(TPERROR)
    clear_screen(TPFUNC)
    WRITE TPDISPLAY('Thank you for using the calculator!',CR)


END calculator
--============================================================
ROUTINE calc
VAR 
    result_ : REAL
BEGIN 
    status_ = 0
    SELECT ope_ OF
        CASE(OP_ADD):
            result_ = num1_ + num2_
        CASE(OP_SUB):
            result_ = num1_ - num2_
        CASE(OP_MUL):
            result_ = num1_ * num2_
        CASE(OP_DIV):
            IF (num2_ <> 0) THEN
                result_ = num1_ / num2_
            ELSE
                WRITE TPDISPLAY('Error: Division by zero!')
                result_ = 0
                status_ = -1
            ENDIF
        CASE(OP_SQUARE):
            square(num1_)
            result_ = num1_
        ELSE:
                result_ =  0
                status_ = -2
    ENDSELECT
    RETURN (result_)
END calc