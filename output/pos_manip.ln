LINENO   63,1967,              WRITE('Error getting tool number: ', status)
LINENO   64,2021,              POST_ERR(status, '', 0, 2)
LINENO   65,2057,              RETURN
LINENO   66,2073,          ENDIF
LINENO   67,2084,          GET_VAR(entry, '*SYSTEM*', '$MNUFRAMENUM[1]', tpp_frame_num, status)
LINENO   68,2158,          IF status <> 0 THEN
LINENO   69,2183,              WRITE('Error getting frame number: ', status)
LINENO   70,2238,              POST_ERR(status, '', 0, 2)
LINENO   71,2274,              RETURN
LINENO   72,2290,          ENDIF
LINENO   74,2326,          str_var_name = '$MNUTOOL[1,' + int2str(tpp_tool_num) + ']'
LINENO   75,2390,          GET_VAR(entry, '*SYSTEM*', str_var_name, tpp_tool_data, status)
