---------------------------------------------------
-- Handling TPP parameters
---------------------------------------------------
ROUTINE GetIntParam
----------------------------------------------------
-- Creation date: 2026.11.24
-- Created by: 
----------------------------------------------------
-- Function: returns int TPP parameter value based on param_no
----------------------------------------------------
-- Arguments: 
--   param_no : INTEGER - the parameter number to retrieve
----------------------------------------------------
-- Return value: 
--   INTEGER - the integer value of the specified TPP parameter
----------------------------------------------------
-- Last modified: 2026.11.24
-- Last modified by: 
----------------------------------------------------
CONST
    TYP_INT     = 1
    TYP_REAL    = 2
    TYP_STRING  = 3
VAR
    data_type   : INTEGER
    int_value   : INTEGER
    real_value  : REAL
    str_value   : STRING[1]
    status      : INTEGER
BEGIN
    GET_TPE_PRM(param_no, data_type, int_value, real_value, str_value, status)
    IF status <> 0 THEN
        POST_ERR(status, '', 0, 2)
        RETURN (0)
    ENDIF
    IF data_type = TYP_INT THEN
        RETURN (int_value)
    ELSE
        POST_ERR(12240, '', 0, 2)
        RETURN (0) -- or some appropriate error value
    ENDIF
END GetIntParam

ROUTINE GetRealParam
----------------------------------------------------
-- Creation date: 2026.11.24
-- Created by: 
----------------------------------------------------
-- Function: returns real TPP parameter value based on param_no
----------------------------------------------------
-- Arguments: 
--   param_no : INTEGER - the parameter number to retrieve
----------------------------------------------------
-- Return value: 
--   REAL - the real value of the specified TPP parameter
----------------------------------------------------
-- Last modified: 2026.11.24
-- Last modified by: 
----------------------------------------------------
CONST
    TYP_INT     = 1
    TYP_REAL    = 2
    TYP_STRING  = 3
VAR
    data_type   : INTEGER
    int_value   : INTEGER
    real_value  : REAL
    str_value   : STRING[1]
    status      : INTEGER
BEGIN
    GET_TPE_PRM(param_no, data_type, int_value, real_value, str_value, status)
    IF status <> 0 THEN
        POST_ERR(status, '', 0, 2)
        RETURN (0)
    ENDIF
    SELECT data_type OF
        CASE(TYP_REAL):
            RETURN (real_value)
        CASE(TYP_INT):
            RETURN(int_value)
        ELSE:
            POST_ERR(12240, '', 0, 2)
            RETURN (0) -- or some appropriate error value
    ENDSELECT
END GetRealParam

ROUTINE GetIntReg
----------------------------------------------------
-- Creation date: 2026.11.24
-- Created by: 
----------------------------------------------------
-- Function: 
----------------------------------------------------
-- Arguments: 
----------------------------------------------------
-- Return value: 
----------------------------------------------------
-- Last modified: 2026.11.24
-- Last modified by: 
----------------------------------------------------
VAR
    real_flag: BOOLEAN
    int_value: INTEGER
    real_value: REAL
    status: INTEGER
BEGIN
    GET_REG(reg_no, real_flag, int_value, real_value, status)
    IF status <> 0 THEN
        -- Handle error
        POST_ERR(status,'',0, 2)
    ENDIF
    IF real_flag THEN
        -- Handle unexpected real value
        POST_ERR(12240,'',0, 2)
    ENDIF
    RETURN (int_value)
END GetIntReg

ROUTINE GetRealReg
----------------------------------------------------
-- Creation date: 2026.11.25
-- Created by: 
----------------------------------------------------
-- Function: 
----------------------------------------------------
-- Arguments: 
----------------------------------------------------
-- Return value: 
----------------------------------------------------
-- Last modified: 2026.11.25
-- Last modified by: 
----------------------------------------------------
VAR
    real_flag: BOOLEAN
    int_value: INTEGER
    real_value: REAL
    status: INTEGER
BEGIN
    GET_REG(reg_no, real_flag, int_value, real_value, status)
    IF status <> 0 THEN
        -- Handle error
        POST_ERR(status,'',0, 2)
    ENDIF
    IF NOT real_flag THEN
        -- Handle unexpected integer value
        RETURN (int_value)
    ENDIF
    RETURN (real_value)
END GetRealReg

