ROUTINE GetCartPosReg
----------------------------------------------------
-- Creation date: 2026.11.25
-- Created by: 
----------------------------------------------------
-- Function: 
----------------------------------------------------
-- Arguments: 
----------------------------------------------------
-- Return value: 
----------------------------------------------------
-- Last modified: 2026.11.25
-- Last modified by: 
----------------------------------------------------
CONST 
    TYP_POS     = 1
    TYP_XYZWPR  = 2
    TYP_XYXEXT  = 6
    TYP_JOINT   = 9
VAR
    posn_type   :INTEGER
    num_axes    :INTEGER
    status      :INTEGER
    ret_value   :XYZWPREXT
BEGIN
    POS_REG_TYPE(reg_no, 1, posn_type, num_axes, status)
    IF status <> 0 THEN
        -- Handle error
        POST_ERR(status,'',0, 2)
    ENDIF
    SELECT posn_type OF
        CASE(TYP_POS,TYP_XYZWPR,TYP_XYXEXT):
            ret_value = GET_POS_REG(reg_no, status)
            IF status <> 0  THEN
                -- Handle error
                POST_ERR(status,'',0, 2)
            ENDIF
        ELSE:
            -- Handle unsupported position type
            POST_ERR(16060,'',0, 2)
    ENDSELECT
    RETURN(ret_value)
    
END GetCartPosReg

ROUTINE int2str --(num_:INTEGER) : STRING
VAR 
  s_     :STRING[16]
BEGIN
  CNV_INT_STR(num_, 0, 0, s_) -- Convert integer to string
  s_ = SUB_STR(s_,2,STR_LEN(s_)) -- Remove leading blank character
  RETURN (s_)
END int2str 

ROUTINE GetTppFrmData--(frame_no : INTEGER) : POSITION FROM my_lib
    VAR 
    max_num_frm :INTEGER
    ret_value   :POSITION
    status      :INTEGER
    entry       :INTEGER
    BEGIN 
        max_num_frm = $SCR.$MAXNUMUFRAM 
        IF (frame_no > 0) AND (frame_no <= max_num_frm) THEN
            GET_VAR(entry, '*SYSTEM*', '$MNUFRAME[1,' + int2str(frame_no) + ']', ret_value, status)
            IF status <> 0 THEN
                -- Handle error
                POST_ERR(status,'',0, 2)
            ENDIF 
            RETURN(ret_value)
        ENDIF 
        IF (frame_no = 0) THEN 
            ret_value = $MOR_GRP[1].$NILPOS
            RETURN(ret_value)
        ENDIF
        IF (frame_no < 0) OR (frame_no > max_num_frm) THEN
            -- Handle invalid frame number
            POST_ERR(16107,'',0, 2)
        ENDIF
END GetTppFrmData

ROUTINE GetTppToolData--(tool_no : INTEGER) : POSITION FROM my_lib
    VAR 
    max_num_tool :INTEGER
    ret_value   :POSITION
    status      :INTEGER
    entry       :INTEGER
    BEGIN 
        max_num_tool = $SCR.$MAXNUMUTOOL 
        IF (tool_no > 0) AND (tool_no <= max_num_tool) THEN
            GET_VAR(entry, '*SYSTEM*', '$MNUTOOL[1,' + int2str(tool_no) + ']', ret_value, status)
            IF status <> 0 THEN
                -- Handle error
                POST_ERR(status,'',0, 2)
            ENDIF 
            RETURN(ret_value)
        ENDIF 
        IF tool_no = 0 THEN 
            ret_value = $MOR_GRP[1].$NILPOS
            RETURN(ret_value)
        ENDIF
        IF (tool_no < 0) OR (tool_no > max_num_tool) THEN
            -- Handle invalid tool number
        POST_ERR(16107,'',0, 2)
    ENDIF
END GetTppToolData