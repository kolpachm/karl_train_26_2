%COMMENT = 'v0.3'
--%ALPHABETIZE
%NOLOCKGROUP
%NOBUSYLAMP
%NOPAUSE = ERROR + COMMAND + TPENABLE
%NOPAUSESHFT
%NOABORT = ERROR + COMMAND
--%SYSTEM
--%PRIORITY = 49
%INCLUDE KLEVKEYS
%INCLUDE KLEVKMSK
%INCLUDE KLEVCCDF
%INCLUDE KLIOUOP
%INCLUDE KLIOTYPS
--CONST
--TYPE
VAR 
    reg_no: INTEGER
    pos_retrieved: XYZWPREXT
    cfg : CONFIG
    cfg_str: STRING[32]
----------------------------------------------------
-- ROUTINE DECL
----------------------------------------------------
%INCLUDE my_lib_h

----------------------------------------------------
-- BEGIN get_set_reg
----------------------------------------------------
BEGIN
    -- GET_REG(register_no, real_flag[out], int_value, real_value, status)
    -- GET_STR_REG(register_no, value, status)
    -- SET_INT_REG(register_no, int_value, status)
    -- SET_REAL_REG(register_no, real_value, status)
    -- POS_REG_TYPE(register_no, group_no, posn_type, num_axes, status)
    -- GET_POS_REG(register_no, status)
    -- GET_JPOS_REG(register_no, status)
    -- SET_JPOS_REG(register_no, jpos, status)
    -- SET_POS_REG(register_no, posn, status)
    clear_screen(TPDISPLAY)
    WRITE('Zadej cislo registru: ')
    READ(reg_no)
    WRITE(CR, 'Hodnote registru R[', reg_no, ']: ', GetRealReg(reg_no),CR)
    WRITE('Zadej cislo poz. registru: ')
    READ(reg_no)
    pos_retrieved = GetCartPosReg(reg_no)
    --IF NOT UNINIT(pos_retrieved)
    -- -9999.999
    WRITE(CR,'X: ', pos_retrieved.x::9::3, ' Y: ', pos_retrieved.y::9::3, ' Z: ', pos_retrieved.z::9::3,CR) 
    WRITE(' W: ', pos_retrieved.w::9::3,' P: ', pos_retrieved.p::9::3,' R: ', pos_retrieved.r::9::3, CR)
    CNV_CONF_STR(pos_retrieved.config_data, cfg_str)
    WRITE(' Config: ', cfg_str, CR)

END get_set_reg 

