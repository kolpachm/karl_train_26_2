LINENO   58,1565,          IF UNINIT(pip_configured) THEN pip_configured = FALSE; ENDIF
LINENO   58,1565,          IF UNINIT(pip_configured) THEN pip_configured = FALSE; ENDIF
LINENO   59,1631,          IF UNINIT(reg_index) THEN reg_index = 1; ENDIF
LINENO   59,1631,          IF UNINIT(reg_index) THEN reg_index = 1; ENDIF
LINENO   59,1631,          IF UNINIT(reg_index) THEN reg_index = 1; ENDIF
LINENO   60,1683,          IF NOT pip_configured THEN
LINENO   61,1715,              PIPE_CONFIG(f_path, cmos_flg, n_sectors, record_size, form_dict, form_ele, status)
LINENO   62,1807,              pip_configured = TRUE
