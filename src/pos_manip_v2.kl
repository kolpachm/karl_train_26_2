PROGRAM pos_manip_v2
----------------------------------------------------
-- Creation date: 2026-11-25
-- Created by: msk
----------------------------------------------------
-- Version info:
--   1.0 - first release
----------------------------------------------------
-- Function: get tpp user frame and tool and convert posiational 
-- data 
-- goal: read sys vars and use them
----------------------------------------------------
-- Last modified: 2026-11-25
-- Last modified by: msk
----------------------------------------------------
%COMMENT = 'v1.2'
--%ALPHABETIZE
%NOLOCKGROUP
%NOBUSYLAMP
%NOPAUSE = ERROR + COMMAND + TPENABLE
%NOPAUSESHFT
%NOABORT = ERROR
--%SYSTEM
--%PRIORITY = 49
%INCLUDE KLEVKEYS
%INCLUDE KLEVKMSK
%INCLUDE KLEVCCDF
%INCLUDE KLIOUOP
%INCLUDE KLIOTYPS
--CONST
TYPE
    t_frame_num FROM pos_manip = STRUCTURE
        t_num : BYTE
        f_num : BYTE
    ENDSTRUCTURE
VAR 
 tpp_tool_num   : INTEGER   -- $MNUTOOLNUM
 str_var_name   : STRING[32]
 tpp_frame_num  : INTEGER   -- $MNUFRAMENUM
 tpp_tool_data  : POSITION  --/XYZWPR : $MNUTOOL[*group*,*tpp_tool_num*]
 tpp_frame_data : POSITION  --/XYZWPR : $MNUFRAME[*group*,*tpp_frame_num*]
 krl_tool_data  : POSITION  --/XYZWPR : $GROUP[1].UTOOL
 krl_frame_data : POSITION  --/XYZWPR : $GROUP[1].UFRAME
 act_pos        : XYZWPR    -- actual position
 entry          : INTEGER
 var_name       : STRING[32]
 status         : INTEGER
 frame_num      : t_frame_num
----------------------------------------------------
-- ROUTINE DECL
----------------------------------------------------
%INCLUDE my_lib_h
----------------------------------------------------
-- BEGIN pos_manip
----------------------------------------------------
BEGIN
    -- option 1:(not used beecause var ype of BYTE
    tpp_tool_num = $MNUTOOLNUM[1]
    tpp_frame_num = $MNUFRAMENUM[1]
    -- copy tpp frames data to karel frame data:
    $GROUP[1].$UTOOL = GetTppToolData(tpp_tool_num)
    $GROUP[1].$UFRAME = GetTppFrmData(tpp_frame_num)
    -- show act pos 
    act_pos = CURPOS(0,0)
    clear_screen(TPDISPLAY)
    WRITE('Actual position: ',CR)
    WRITE('X: ', act_pos.X::9::3, ' Y: ', act_pos.Y::9::3, ' Z: ', act_pos.Z::9::3,CR)
    WRITE('W: ', act_pos.W::9::3, ' P: ', act_pos.P::9::3, ' R: ', act_pos.R::9::3, CR)
END pos_manip_v2